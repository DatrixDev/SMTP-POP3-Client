# Copy this file to .env and set local development passwords.
# Do not commit .env.
MYSQL_ROOT_PASSWORD=change_this_root_password
MYSQL_USER=mailapp
MYSQL_PASSWORD=change_this_app_password
MYSQL_PORT=3307

# Java desktop mail client (same .env; never commit actual credentials)
MAIL_EMAIL=your-email@gmail.com
MAIL_APP_PASSWORD=your-16-character-app-password
MAIL_SMTP_HOST=smtp.gmail.com
MAIL_SMTP_PORT=587
MAIL_POP3_HOST=pop.gmail.com
MAIL_POP3_PORT=995
